{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r",
        "REditorSupport.r-syntax",
        "RDebugSupport.r-debugger",
        "etiennebacher.jarl-vscode",
        "Posit.air-vscode"
      ],
      "settings": {
        "r.lsp.path": "/usr/local/bin/R",
        "r.rterm.linux": "/usr/local/bin/R"
      }
    }
  },
  "forwardPorts": [],
  "name": "R Project Template",
  "postCreateCommand": "rv sync && just pre-commit-install && just pre-commit"
}
